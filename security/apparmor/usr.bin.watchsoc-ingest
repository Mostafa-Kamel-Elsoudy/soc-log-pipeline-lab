# AppArmor profile for the WatchSOC ingest API.
# Install:   sudo cp security/apparmor/usr.bin.watchsoc-ingest /etc/apparmor.d/
# Load:      sudo apparmor_parser -r /etc/apparmor.d/usr.bin.watchsoc-ingest
# Complain:  sudo aa-complain /etc/apparmor.d/usr.bin.watchsoc-ingest
# Enforce:   sudo aa-enforce /etc/apparmor.d/usr.bin.watchsoc-ingest
# The profile is named, not path-attached. systemd applies it through
# AppArmorProfile=watchsoc-ingest in watchsoc-ingest.service, so other Node
# programs on the host are not confined.

#include <tunables/global>

profile watchsoc-ingest flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/openssl>

  # Runtime and application code.
  /usr/bin/node                          mrix,
  /usr/lib/** mr,
  /lib/** mr,
  /opt/watchsoc-ingest/**                r,
  /opt/watchsoc-ingest/                  r,

  # Node reads these on startup.
  /proc/sys/kernel/random/uuid           r,
  /proc/sys/vm/overcommit_memory         r,
  /proc/sys/net/core/somaxconn           r,
  /proc/meminfo                          r,
  /proc/cpuinfo                          r,
  /proc/self/** r,
  /sys/devices/system/cpu/**             r,
  /sys/fs/cgroup/**                      r,

  # DNS and TLS trust store.
  /etc/ssl/certs/**                      r,
  /etc/ca-certificates/**                r,
  /etc/resolv.conf                       r,
  /etc/hosts                             r,
  /etc/localtime                         r,
  /usr/share/zoneinfo/**                 r,
  /etc/nsswitch.conf                     r,

  # TCP only. AppArmor cannot filter by address: the loopback restriction
  # comes from HOST=127.0.0.1 in the unit and from UFW.
  network inet stream,
  network inet6 stream,
  network unix stream,

  # The only path the service writes. rsyslog tails this file.
  /var/log/watchsoc-ingest.log           rw,

  # Explicit denials for sensitive host paths.
  deny /etc/shadow*                      rwklx,
  deny /etc/gshadow*                     rwklx,
  deny /etc/sudoers*                     rwklx,
  deny /etc/ssh/**                       rwklx,
  deny /root/**                          rwklx,
  deny /home/**                          rwklx,
  deny /var/log/auth.log*                rwklx,
  deny /var/log/soc-structured.json      rwklx,
  deny /var/spool/rsyslog/**             rwklx,
  deny /boot/**                          rwklx,
  deny /dev/mem                          rwklx,
  deny /proc/sys/kernel/** w,
  deny ptrace,
  deny mount,
}
